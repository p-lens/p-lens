+-- | A commodity symbol, as commoditysymbolp parses it, and the text after it: either quoted
+-- (as quotedcommoditysymbolp: double quotes around any characters but a semicolon, a newline or
+-- a double quote; the symbol is what is inside them) or simple (as simplecommoditysymbolp: one
+-- or more characters that are not isNonsimpleCommodityChar). Nothing when neither begins here,
+-- including an unterminated quoted symbol, which the general parser reports.
+scanCommoditySymbol :: Text -> Maybe (CommoditySymbol, Text)
+scanCommoditySymbol t = case T.uncons t of
+  Just ('"', r) ->
+    let (sym, r') = T.span (\c -> c /= ';' && c /= '\n' && c /= '"') r
+    in case T.uncons r' of
+      Just ('"', r'') -> Just (sym, r'')
+      _ -> Nothing
+  Just (c, _) | not (isNonsimpleCommodityChar c) -> Just (T.span (not . isNonsimpleCommodityChar) t)
+  _ -> Nothing
+
