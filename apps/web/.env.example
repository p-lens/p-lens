# Copy to .env.local (ignored by git) and fill in what your deployment has.
# Each is optional: left out, the app runs without it.

# The shared catalog's API: /api when it is served under the app's own origin,
# http://localhost:8787 for `bun --cwd=apps/api run dev`.
VITE_CATALOG_URL=

# Where the parlor list's JSONL is published, ending in a slash.
VITE_PARLORS_URL=

# Where a parlor not on the list is submitted.
VITE_SURVEY_URL=

# The Turnstile site key of the deployment's widget; set with the API's TURNSTILE_SECRET.
VITE_TURNSTILE_SITE_KEY=

# The sync relay a book starts syncing through: http://localhost:8788 for
# `bun --cwd=apps/relay run dev`. Left out, no book is synced or joined.
VITE_RELAY_URL=

# The OAuth 2.0 client id (a "Web application" client in Google Cloud, with
# this deployment's origin among its authorised JavaScript origins) books are
# backed up to Google Drive under. Left out, a book is backed up to a file only.
VITE_GOOGLE_CLIENT_ID=
