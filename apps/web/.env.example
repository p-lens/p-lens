# Copy to .env.local (ignored by git) and fill in what your deployment has.
# Each is optional: left out, the app runs without it.

# The branding built with: a folder of src/branding/. Left out, default — a
# plain name (マイレンズ), kept out of search results — which a fork makes its
# own. p-lens is app.p-lens.jp's operator's alone.
BRANDING=

# The shared catalog's API: /api when it is served under the app's own origin,
# http://localhost:8787 for `bun --cwd=apps/api run dev`.
VITE_CATALOG_URL=

# Where the parlor list's JSONL is published, ending in a slash.
VITE_PARLORS_URL=

# Where a parlor not on the list is submitted.
VITE_SURVEY_URL=

# Where p-lens-brokers' observations.jsonl is published, ending in a slash: the
# exchange a parlor's 4-yen or 20-yen corner was reported at comes from it.
# Left out, only a reported rental is filled in.
VITE_BROKERS_URL=

# The Turnstile site key of the deployment's widget; set with the API's TURNSTILE_SECRET.
VITE_TURNSTILE_SITE_KEY=

# The Nostr relay a book starts syncing through and a huddle is started on
# (wss://…): ws://127.0.0.1:7780 for p-lens-relay's hosts/bun, or
# ws://127.0.0.1:7790 for its fake. Left out, nothing crosses devices and the
# app plays alone.
VITE_RELAY_URL=

# The OAuth 2.0 client id (a "Web application" client in Google Cloud, with
# this deployment's origin among its authorised JavaScript origins) books are
# backed up to Google Drive under. Left out, a book is backed up to a file only.
VITE_GOOGLE_CLIENT_ID=

# The browser API key the Google Picker is shown with, from the same Google
# Cloud project, with the Google Picker API enabled there. Restrict it to this
# deployment's origin and https://docs.google.com/*, where the Picker runs.
# Through the Picker a person chooses backups in their Drive the app did not
# make itself, as one uploaded again by hand.
VITE_GOOGLE_API_KEY=
