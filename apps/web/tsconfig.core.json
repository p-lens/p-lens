{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.core.tsbuildinfo",
    "lib": ["ES2023"],
    "types": []
  },
  /* The pure core, with no DOM and no ambient types at all: a `window`, a
     `fetch` or a `localStorage` written here does not compile. What it may
     import beyond itself is hledger's wire types, which are types only. */
  "include": ["src/core", "src/hledger/protocol/wire.ts"]
}
