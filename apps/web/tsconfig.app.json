{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "types": ["vite/client", "vite-plugin-pwa/client", "vite-plugin-pwa/solid"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "paths": { "@branding/*": ["./src/branding/default/*"] }
  },
  "include": ["src"],
  "exclude": ["src/branding/brandings.ts"]
}
