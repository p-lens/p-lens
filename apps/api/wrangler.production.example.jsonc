{
  // A deployment of the shared catalog's API. Copy this file to
  // wrangler.production.jsonc (ignored by git, so your account's ids and
  // hosts never reach the repository), fill in what is marked <…>, then:
  //
  //   bun --cwd=apps/api run migrate:remote
  //   bun --cwd=apps/api run deploy
  //
  // The API is served under the app's own origin, at /api, so it has no
  // address of its own to find: the app asks /api/catalog of the page it is on.
  "name": "p-lens-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [{ "pattern": "<app.example.com>/api/*", "zone_name": "<example.com>" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "p-lens",
      // The id `wrangler d1 create p-lens` printed.
      "database_id": "<your D1 database id>",
      "migrations_dir": "../../db/migrations"
    }
  ],
  // How often one address may write, per minute: any write, and registering
  // something new. Pick any two namespace ids unique in your account.
  "ratelimits": [
    { "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "CREATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // Two secrets are set apart from this file, never written in it:
  //   bunx wrangler secret put ADMIN_TOKEN --config wrangler.production.jsonc
  //   bunx wrangler secret put TURNSTILE_SECRET --config wrangler.production.jsonc
  "vars": {
    // The pages the app is served from, comma-separated. Only they may read
    // or write; a copy of the app served anywhere else is refused. Left
    // empty, anyone may.
    "ALLOWED_ORIGINS": "https://<app.example.com>",
    // The prefix of the route above.
    "API_BASE_PATH": "/api"
  },
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }]
}
