    "@p-lens/pachislot-engine": "workspace:*",
    "@p-lens/uuidv7": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/bun": "^1.3.14",
    "typescript": "~6.0.2",
    "wrangler": "^4.147.0"
  }
}
