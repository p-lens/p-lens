{
  "name": "@p-lens/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --config wrangler.production.jsonc",
    "migrate:local": "wrangler d1 migrations apply p-lens --local",
    "migrate:remote": "wrangler d1 migrations apply p-lens --remote --config wrangler.production.jsonc",
